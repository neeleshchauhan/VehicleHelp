{
  "expo": {
    "name": "VehicleHelpNew",
    "slug": "vehiclehelp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vehiclehelpnew",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "package": "com.neeleshchauhan5458steam.vehiclehelp",
      "config": {
        "googleMaps": {
          "apiKey": "DUMMY_KEY_TO_PREVENT_APP_CRASH"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-speech-recognition",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow VehicleHelp to access your location for emergency assistance."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow VehicleHelp to access photos to upload shop photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "739c5b60-a007-4d9c-b6e0-e1cb072611a8"
      }
    },
    "owner": "neeleshchauhan5458s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/739c5b60-a007-4d9c-b6e0-e1cb072611a8"
    }
  }
}